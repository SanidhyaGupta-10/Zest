generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  userId    String   @unique // For questions
  createdAt DateTime @default(now())
}

model Question {
  id        String   @id @default(cuid())
  topic     String
  questions Json
  userId    String?
  createdAt DateTime @default(now())
}