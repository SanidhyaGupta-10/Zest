generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id           // ✅ Clerk userId
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())

  documents Document[]
  questions Question[]
  summaries Summary[]
  notes     Note[]
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  content   String
  embedding Unsupported("vector")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Question {
  id        String   @id @default(cuid())
  topic     String
  questions Json
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Summary {
  id        String   @id @default(cuid())
  content   String
  result    String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  topic     String
  notes     String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}